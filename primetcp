#include <stdio.h>
#include <arpa/inet.h>
#include <unistd.h>

#define PORT 12345

int main() {
    int sock;
    int num;
    char result[100];

    struct sockaddr_in server_addr;

    // Create TCP socket
    sock = socket(AF_INET, SOCK_STREAM, 0);

    // Configure server address
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    // Connect to server
    connect(sock,
            (struct sockaddr *)&server_addr,
            sizeof(server_addr));

    // Read number
    printf("Enter a number: ");
    scanf("%d", &num);

    // Send number
    send(sock,
         &num,
         sizeof(num),
         0);

    // Receive result
    recv(sock,
         result,
         sizeof(result),
         0);

    // Display result
    printf("Server: %s\n", result);

    // Close socket
    close(sock);

    return 0;
}
